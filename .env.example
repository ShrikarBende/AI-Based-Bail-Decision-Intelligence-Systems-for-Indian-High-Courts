# ======================================
# JudicialAI Backend Environment Config
# ======================================

# Required: Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Gemini API Key (for DocHub document drafting)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default JWT secret (recommended for production)
JWT_SECRET_KEY=your_jwt_secret_key_here
